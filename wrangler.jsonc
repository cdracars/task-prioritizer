{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "task-prioritizer",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "task-prioritizer.dracars.com",
      "custom_domain": true,
    },
  ],
}
